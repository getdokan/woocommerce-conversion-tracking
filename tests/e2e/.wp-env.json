{
    "$schema": "https://schemas.wp.org/trunk/wp-env.json",
    "core": "https://wordpress.org/wordpress-7.1.4.zip",
    "phpVersion": "8.3",
    "port": 8894,
    "testsEnvironment": false,
    "plugins": [
        "https://downloads.wordpress.org/plugin/woocommerce.11.2.2.zip",
        "https://downloads.wordpress.org/plugin/yith-woocommerce-wishlist.4.20.0.zip"
    ],
    "themes": ["https://downloads.wordpress.org/theme/storefront.zip"],
    "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": "/var/www/html/wp-data/debug.log",
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": false,
        "WP_AUTO_UPDATE_CORE": false,
        "AUTOMATIC_UPDATER_DISABLED": true
    },
    "mappings": {
        "wp-content/plugins/woocommerce-conversion-tracking": "../../",
        "wp-content/mu-plugins": "./mu-plugins",
        "wp-data": "./wp-data"
    },
    "lifecycleScripts": {
        "afterStart": "npm run env:setup"
    }
}
