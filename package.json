{
    "name": "Woocommerce-Conversion-Tracking",
    "version": "2.1.6",
    "description": "Conversion tracking plugin for WooCommerce",
    "author": "Tareq Hasan",
    "license": "GPL",
    "private": true,
    "scripts": {
        "build": "lessc assets/less/style.less assets/css/style.css",
        "start": "node --watch-path=assets/less node_modules/less/bin/lessc assets/less/style.less assets/css/style.css",
        "makepot": "wp i18n make-pot . languages/woocommerce-conversion-tracking.pot --domain=woocommerce-conversion-tracking --include=conversion-tracking.php,includes",
        "version": "node bin/version-replace.js",
        "clean": "node bin/clean.js",
        "zip": "node bin/zip.js",
        "release": "npm run clean && npm install && npm run build && npm run makepot && npm run version && npm run zip",
        "release:dev": "npm run clean && npm install && npm run build && npm run makepot && npm run zip"
    },
    "devDependencies": {
        "archiver": "^7.0.1",
        "less": "^4.9.1"
    }
}
