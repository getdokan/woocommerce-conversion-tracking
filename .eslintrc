{
    "extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
    "settings": {
        "import/resolver": {
            "node": {
                "paths": [ "src" ],
                "extensions": [ ".js", ".jsx", ".ts", ".tsx" ]
            },
            "typescript": {
                "project": "./tsconfig.json"
            }
        }
    }
}
